{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sandsphere",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "not_found_handling": "single-page-application"},
  "routes": [{"pattern": "sandsphere.app", "custom_domain": true}]
}
