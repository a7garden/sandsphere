{
  "name": "sandsphere",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --maxWorkers=2 --testTimeout=20000",
    "dev:emulator": "vite --host 127.0.0.1 --port 5174 --mode emulator",
    "emulators": "firebase emulators:start --project demo-sandsphere --only auth,firestore,storage",
    "test:rules": "firebase emulators:exec --project demo-sandsphere --only firestore,storage \"vitest run tests/account-rules.test.ts\"",
    "build:production": "node scripts/check-production.mjs && npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@fontsource/space-grotesk": "5.3.0",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@webgpu/types": "0.1.74",
    "firebase-tools": "15.33.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/core": "^2.12.0",
    "basic-ftp": "^6.2.3"
  }
}
